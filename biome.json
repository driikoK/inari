{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["backend/src/**", "backend/test/**", "frontend/src/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "auto"
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["backend/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noDuplicateEnumValues": "off"
          }
        }
      }
    },
    {
      "includes": ["frontend/**"],
      "formatter": {
        "lineWidth": 100
      },
      "css": {
        "formatter": {
          "quoteStyle": "single"
        }
      },
      "linter": {
        "rules": {
          "a11y": "off",
          "complexity": {
            "noBannedTypes": "error",
            "noUselessCatch": "error"
          },
          "correctness": {
            "useExhaustiveDependencies": "warn",
            "useHookAtTopLevel": "error"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useComponentExportOnlyModules": {
              "level": "warn",
              "options": {
                "allowConstantExport": true
              }
            }
          },
          "suspicious": {
            "noArrayIndexKey": "warn",
            "noEmptyBlockStatements": "error",
            "noExplicitAny": "error",
            "noPrototypeBuiltins": "error",
            "noThenProperty": "off"
          }
        }
      }
    }
  ]
}
