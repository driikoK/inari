# MongoDB configuration
MONGO_USERNAME="admin"
MONGO_PASSWORD="admin"
MONGO_DATABASE="inari"
MONGO_PORT="27017"
MONGO_HOST="localhost"

CORS=

# Port the API listens on (defaults to 8000)
PORT=

# Uploaded project posters: the folder they are kept in (defaults to uploads/posters under the
# working directory) and the public address that folder is served at (defaults to
# http://localhost:<PORT>/posters). The address is required when NODE_ENV=production
POSTERS_DIR=
POSTERS_URL=

MAILER_USER=
MAILER_PASS=

JWT_SECRET_KEY=

# Seeds (npm run seed:root / seed:users). A random password is generated and printed when empty
ROOT_PASSWORD=
ROOT_EMAIL=
SEED_USER_PASSWORD=