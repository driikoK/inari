{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "biome format --write",
    "format:check": "biome format",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "command": "node dist/cli.js",
    "seed:all": "nest build && node dist/cli.js seed:all",
    "seed:root": "nest build && node dist/cli.js seed:root",
    "seed:users": "nest build && node dist/cli.js seed:users",
    "seed:nicknames": "nest build && node dist/cli.js seed:nicknames",
    "seed:anime": "nest build && node dist/cli.js seed:anime",
    "seed:team-animes": "nest build && node dist/cli.js seed:team-animes",
    "seed:votes": "nest build && node dist/cli.js seed:votes",
    "seed:proposals": "nest build && node dist/cli.js seed:proposals",
    "seed:projects": "nest build && node dist/cli.js seed:projects",
    "seed:tracks": "nest build && node dist/cli.js seed:tracks",
    "seed:budget": "nest build && node dist/cli.js seed:budget",
    "seed:clear": "nest build && node dist/cli.js seed:clear",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "mongoose": "^8.2.4",
    "nodemailer": "^7.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@golevelup/ts-vitest": "^4.0.0",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "@scarf/scarf": false,
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
